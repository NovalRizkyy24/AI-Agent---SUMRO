# Salin jadi .env lalu isi. File .env JANGAN di-commit.
# API key model AI tidak ditaruh di sini: wizard `hermes setup` menyimpannya
# di hermes-data/.env.

# --- WhatsApp (bridge bawaan Hermes, nomor bot terpisah) ---
WHATSAPP_ENABLED=true
WHATSAPP_MODE=bot
# Semua grup yang dimasuki bot diteruskan ke plugin; plugin sendiri yang
# memutuskan grup mana yang aktif (lewat /aktifkan).
WHATSAPP_GROUP_POLICY=open
# Wajib false: kalau true, pesan biasa tidak sampai ke plugin dan tidak tercatat.
WHATSAPP_REQUIRE_MENTION=false
# Wajib true bersama GROUP_POLICY=open (gateway menolak start tanpa ini).
# Aman untuk SUMROM: plugin men-skip semua pesan WhatsApp sebelum sampai ke
# agen, jadi agen tidak pernah membalas siapa pun.
WHATSAPP_ALLOW_ALL_USERS=true

# --- SUMROM ---
# Nomor admin bot, format 62..., dipisah koma. Hanya mereka yang bisa
# /aktifkan, /nonaktifkan, /jadwal, /gaya. Kalau grup memakai ID samaran
# (LID), ketik /idsaya di grup lalu tempel ID yang muncul di sini.
SUMROM_ADMINS=
# Link landing page (Vercel), muncul di /bantuan dan pesan aktivasi.
SUMROM_LANDING_URL=https://ai-agent-sumro.vercel.app
# whatsapp (default) atau markdown. Ganti ke markdown hanya kalau tanda
# *tebal* tampil sebagai _miring_ di grup.
SUMROM_TEXT_STYLE=whatsapp

TZ=Asia/Jakarta
