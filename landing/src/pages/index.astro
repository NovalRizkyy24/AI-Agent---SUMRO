---
import '@fontsource-variable/schibsted-grotesk';
import '@fontsource/jetbrains-mono/500.css';
import '../styles/site.css';

const description = 'Grup ini dirangkum SUMROM Bot. Apa yang dicatat, apa risikonya, dan cara menolaknya.';
const pageUrl = new URL('/', Astro.site).href;
const ogImage = new URL('/og.png', Astro.site).href;

// Pecah teks supaya perintah (/ringkas, /nonaktifkan, ...) tampil sebagai kode.
const withCmds = (text: string) =>
  text.split(/(\/[a-z]+(?: 3 jam)?)/).map((part, i) => ({ part, cmd: i % 2 === 1 }));

const facts = [
  { label: 'Dicatat', text: 'Pesan teks yang dikirim di grup ini.' },
  { label: 'Dikirim ke model AI', text: 'Isi pesan, supaya bisa diringkas.' },
  { label: 'Keberatan?', text: 'Admin wajib mengetik /nonaktifkan.', alert: true },
];

const decisions = ['Rapat pindah ke Kamis, 19.00.', 'Iuran kas naik jadi Rp20.000.'];

const tasks = [
  { what: 'Slide bab 2', who: 'Rina', when: 'Kamis', s: 'Buka' },
  { what: 'Bayar kas', who: 'Dimas', when: 'Senin', s: 'Lewat tenggat', tone: 'late' },
  { what: 'Booking ruang', who: 'Ayu', when: 'Jumat', s: 'Selesai', tone: 'done' },
  { what: 'Rekap absen', who: 'Bayu', when: null, s: 'Buka' },
];

const open = ['Siapa yang pegang kunci ruangan?'];

const recorded = [
  { k: 'Nama atau nomor pengirim', v: 'Supaya ringkasan tahu siapa bilang apa.' },
  { k: 'Isi pesan teks', v: 'Bahan ringkasan.' },
  { k: 'Waktu kirim', v: 'Supaya /ringkas 3 jam tahu batasnya.' },
  { k: 'Ringkasan dan tugas', v: 'Hasil /ringkas, termasuk siapa, apa, kapan.' },
];

const notRecorded = [
  { k: 'Gambar dan voice note', v: 'Tidak dibaca. Hanya ditandai [media].' },
  { k: 'Pesan saat bot mati', v: 'Tidak tercatat sama sekali.' },
];

const commands = [
  { c: '/ringkas', v: 'Semua pesan sejak ringkasan terakhir.' },
  { c: '/ringkas 3 jam', v: 'Hanya rentang waktu yang kamu sebut. Bisa juga "hari ini".' },
  { c: '/tugas', v: 'Daftar tugas yang terdeteksi, dengan status.' },
  { c: '/cari kata', v: 'Temukan diskusi lama.' },
  { c: '/bantuan', v: 'Semua perintah.' },
];

const adminCommands = [
  { c: '/aktifkan', v: 'Bot mulai mencatat grup ini.' },
  { c: '/nonaktifkan', v: 'Bot berhenti mencatat. Wajib dipakai kalau ada yang keberatan.' },
  { c: '/jadwal 21:00', v: 'Ringkasan otomatis tiap hari di jam itu.' },
  { c: '/gaya singkat', v: 'Atur panjang ringkasan: singkat atau detail.' },
];

const risks = [
  { k: 'Isi pesan keluar dari WhatsApp.', v: 'Teksnya dikirim ke penyedia model AI. Itu satu-satunya cara bot bisa merangkum.' },
  { k: 'Jangan bahas data rahasia di sini.', v: 'Nomor rekening, data pribadi, hal sensitif: bahas di luar grup ini selama bot aktif.' },
  { k: 'Bot mati, pesan hilang.', v: 'Pesan yang masuk saat bot mati tidak tercatat. Ringkasan bisa bolong.' },
  { k: 'Ringkasan bisa keliru.', v: 'Untuk keputusan penting, cek pesan aslinya sebelum bertindak.' },
];
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#fbfbfc" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0e0f11" media="(prefers-color-scheme: dark)" />
    <title>SUMROM · Grup ini dirangkum bot</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={pageUrl} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Pratinjau link saat dibagikan di WhatsApp -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:site_name" content="SUMROM" />
    <meta property="og:title" content="Grup ini dirangkum bot." />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Grup ini dirangkum bot. Keberatan? Admin wajib mengetik /nonaktifkan." />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <div class="wrap">
      <header class="bar">
        <span class="bar__mark">SUMROM</span>
        <span class="bar__num">Bot · 0895-2161-4500</span>
      </header>

      <main>
        <section class="intro" aria-labelledby="judul">
          <h1 class="display" id="judul"><span>Grup ini</span> <span>dirangkum bot.</span></h1>
          <p class="lede">Admin grup ini memasang SUMROM. Ini yang dicatat, risikonya, dan cara menolaknya.</p>
          <ul class="facts">
            {facts.map((f) => (
              <li class:list={['fact', { 'fact--alert': f.alert }]}>
                <p class="fact__label">{f.label}</p>
                <p class="fact__text">{withCmds(f.text).map((p) => (p.cmd ? <code>{p.part}</code> : p.part))}</p>
              </li>
            ))}
          </ul>
        </section>

        <section class="section" aria-labelledby="contoh">
          <div>
            <h2 class="section__title" id="contoh">Isi satu ringkasan</h2>
            <p class="section__note">
              Ketik <code>/ringkas</code> dan bot membalas di grup. Bagian yang kosong dilewati, tidak dikarang. Tugas tanpa tenggat ditulis tanpa tenggat.
            </p>
          </div>

          <article class="sample" aria-label="Contoh ringkasan">
            <div class="sample__head">
              <div>
                <p class="sample__title">Ringkasan grup</p>
                <p class="sample__meta">Hari ini, sampai 21.00</p>
              </div>
              <span class="pill">Contoh</span>
            </div>

            <div>
              <h3 class="sub">Keputusan</h3>
              <ul class="list">{decisions.map((d) => <li>{d}</li>)}</ul>
            </div>

            <div>
              <h3 class="sub">Tugas</h3>
              <ul class="list tasks">
                {tasks.map((t) => (
                  <li>
                    <span class="task__what">{t.what}</span>
                    <span class="task__meta">{t.who} · {t.when ?? 'tanpa tenggat'}</span>
                    <span class:list={['task__status', t.tone && `task__status--${t.tone}`]}>{t.s}</span>
                  </li>
                ))}
              </ul>
            </div>

            <div>
              <h3 class="sub">Belum terjawab</h3>
              <ul class="list">{open.map((q) => <li>{q}</li>)}</ul>
            </div>
          </article>
        </section>

        <section class="section" aria-labelledby="catat">
          <h2 class="section__title" id="catat">Yang dicatat, dan yang tidak</h2>
          <div class="split">
            <div>
              <h3 class="sub">Dicatat</h3>
              <ul class="big-list">
                {recorded.map((r) => <li><strong>{r.k}</strong><span>{withCmds(r.v).map((p) => (p.cmd ? <code>{p.part}</code> : p.part))}</span></li>)}
              </ul>
            </div>
            <div>
              <h3 class="sub">Tidak dicatat</h3>
              <ul class="big-list big-list--off">
                {notRecorded.map((r) => <li><strong>{r.k}</strong><span>{r.v}</span></li>)}
              </ul>
            </div>
          </div>
        </section>

        <section class="section" aria-labelledby="perintah">
          <div>
            <h2 class="section__title" id="perintah">Perintah</h2>
            <p class="section__note">Ketik langsung di grup.</p>
          </div>
          <div>
            <h3 class="sub">Semua anggota</h3>
            <dl class="cmds">
              {commands.map((c) => <div class="cmd"><dt><code>{c.c}</code></dt><dd>{c.v}</dd></div>)}
            </dl>
            <h3 class="sub">Khusus admin</h3>
            <dl class="cmds">
              {adminCommands.map((c) => <div class="cmd"><dt><code>{c.c}</code></dt><dd>{c.v}</dd></div>)}
            </dl>
          </div>
        </section>

        <section class="section section--full" aria-labelledby="risiko">
          <h2 class="section__title" id="risiko">Risikonya</h2>
          <div>
            <ul class="risks">
              {risks.map((r) => <li><strong>{r.k}</strong><span>{r.v}</span></li>)}
            </ul>
            <div class="objection">
              <p>Satu orang keberatan sudah cukup.</p>
              <p>Bilang ke admin. Admin wajib mengetik <code>/nonaktifkan</code>, dan bot berhenti mencatat grup ini.</p>
            </div>
          </div>
        </section>

        <section class="close" aria-labelledby="balik">
          <h2 class="display" id="balik">Balik ke grup.</h2>
          <p class="close__line">Ketik <code>/ringkas</code>. Ketinggalan apa pun, keputusan dan tugasnya ada di situ.</p>
        </section>
      </main>

      <footer class="foot">
        <span>SUMROM Bot · 0895-2161-4500</span>
        <span>Halaman ini dibagikan oleh admin grup.</span>
      </footer>
    </div>

    <dialog class="promo" id="promo" aria-labelledby="promo-title" tabindex="-1">
      <form method="dialog" class="promo__inner">
        <h2 class="promo__title" id="promo-title">Kode redeem</h2>
        <p class="promo__text">alah miskin</p>
        <div class="promo__code">
          <code id="promo-code">AMSSRBLHGSHARKM</code>
          <button type="button" class="promo__copy" data-copy>Salin</button>
        </div>
        <button type="submit" class="promo__close">Tutup</button>
      </form>
    </dialog>

    <script>
      // Pop-up kode redeem: tampil sekali per browser, saat kunjungan pertama.
      const KEY = 'sumrom-promo-dilihat';
      const dialog = document.getElementById('promo') as HTMLDialogElement | null;

      const seen = () => {
        try { return localStorage.getItem(KEY) === '1'; } catch { return false; }
      };
      const remember = () => {
        try { localStorage.setItem(KEY, '1'); } catch { /* mode privat: tidak apa-apa */ }
      };

      if (dialog && typeof dialog.showModal === 'function' && !seen()) {
        dialog.showModal();
        dialog.focus(); // fokus ke kotak, bukan tombol pertama
        dialog.addEventListener('close', remember, { once: true });
        // Klik di luar kotak menutup pop-up.
        dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });

        const copyBtn = dialog.querySelector<HTMLButtonElement>('[data-copy]');
        const code = document.getElementById('promo-code')?.textContent?.trim() ?? '';
        copyBtn?.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(code);
            copyBtn.textContent = 'Tersalin';
          } catch {
            const range = document.createRange();
            range.selectNodeContents(document.getElementById('promo-code')!);
            const sel = window.getSelection();
            sel?.removeAllRanges();
            sel?.addRange(range);
            copyBtn.textContent = 'Tekan Ctrl+C';
          }
        });
      }
    </script>
  </body>
</html>
