---
// Satu strip flap: nilai status atau label baris di papan.
interface Props {
  text: string;
  tone?: 'white' | 'amber' | 'red' | 'dim';
  flip?: boolean;
}
const { text, tone = 'white', flip = false } = Astro.props;
---
<span class:list={['flap', `flap--${tone}`]}>
  <span class="sr-only">{text}</span>
  <span class="flap__face" aria-hidden="true" data-flip={flip ? text.toUpperCase() : undefined}>{text.toUpperCase()}</span>
</span>
